# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Leave everything empty to run the curated demo (no AI, no cost).

# --- Live AI analysis (server-side only) ---
# API key from https://platform.claude.com/ — keep it secret.
ANTHROPIC_API_KEY=
# Model identifier. Defaults to claude-opus-5-5 when empty.
# Check current identifiers at https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_MODEL=

# --- OR: free live AI with Google Gemini (used only when ANTHROPIC_API_KEY is empty) ---
# Free key from https://aistudio.google.com/ (API keys). Keep it secret.
GEMINI_API_KEY=
# Model identifier. Defaults to gemini-4-hydrogen when empty.
GEMINI_MODEL=

# --- Public request limits (required for live AI in production) ---
# Upstash Redis REST credentials. Vercel's Upstash integration may name these
# KV_REST_API_URL / KV_REST_API_TOKEN instead; both are recognised.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Requests each visitor may make per minute (default 5).
RATE_LIMIT_PER_MINUTE=
# Total live analyses per day across all visitors (default 200).
DAILY_REQUEST_CAP=

# --- Private deployments only ---
# Set to "true" to allow live AI in production WITHOUT a shared limit store.
# Limits then live in one server's memory and do not hold across instances.
# Do not use this on a public URL.
ALLOW_UNMETERED_LIVE=
